{
  "name": "xu-language",
  "displayName": "Xu Language Support",
  "description": "Language support and LSP integration for the Xu programming language (.xu) — syntax highlighting, diagnostics, hover, definition, completion, formatting, and symbols.",
  "version": "0.3.0",
  "publisher": "xu-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:xu"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "xu",
    "language",
    "syntax",
    "highlighting",
    "lsp",
    "diagnostics"
  ],
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xulang-org/vscode-xu"
  },
  "contributes": {
    "commands": [
      {
        "command": "xu.restartServer",
        "title": "Xu: Restart Language Server",
        "category": "Xu"
      },
      {
        "command": "xu.showOutput",
        "title": "Xu: Show Language Server Output",
        "category": "Xu"
      }
    ],
    "configuration": {
      "title": "Xu",
      "properties": {
        "xu.languageServerPath": {
          "type": "string",
          "default": "xu",
          "description": "Path to the Xu compiler binary; run as `xu lsp` for diagnostics, hover, and definition."
        }
      }
    },
    "languages": [
      {
        "id": "xu",
        "aliases": [
          "Xu",
          "xu"
        ],
        "extensions": [
          ".xu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xu",
        "scopeName": "source.xu",
        "path": "./syntaxes/xu.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://xulang.org",
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
